{
  "name": "router-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Router 网页面板：React 19 浏览器控制台 + 回环桥接服务",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:bridge": "node server/index.mjs --dev",
    "dev:all": "node server/dev.mjs",
