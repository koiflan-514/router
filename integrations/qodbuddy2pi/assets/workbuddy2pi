/**
 * 打开总控并落在指定页。
 *
 * 用 spawn 而不是 require：总控自己 require 了本文件，直接 require 回去会成环。
 * spawn 时把 stdio 交出去，让总控拥有真终端。
 */
function openConsole(pageNo) {
