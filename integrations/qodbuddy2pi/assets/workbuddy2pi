// ---------------------------------------------------------------- opencode
//
// opencode 只会说 OpenAI，而本机反代本来就暴露了 OpenAI 兼容端点，所以不需要翻译层，
// 只要把 provider 写进它的配置即可。配置合并交给 opencode-config.js（三家共用一份
// 实现，避免各写一遍而漂移）。

function opencodeConfig() {
  const candidates = [path.join(__dirname, 'opencode-config.js')];
  const cfg = readJson(path.join(HOME, '.qoder2pi', 'config.json'));
  if (cfg && cfg.repo) candidates.push(path.join(cfg.repo, 'assets', 'opencode-config.js'));
  for (const file of candidates) {
    if (fs.existsSync(file)) {
      try {
        return require(file);
      } catch {
        // 损坏的副本就试下一个
      }
    }
  }
  return null;
}

/** 同步探一下反代的 /v1/models：子命令是同步流程，用 node -e 发请求。 */
function proxyModels(base) {
  const r = run('node', [
    '-e',
    `fetch('${base}/v1/models',{signal:AbortSignal.timeout(6000)}).then(r=>r.json()).then(d=>process.stdout.write(JSON.stringify(d))).catch(()=>process.stdout.write('null'))`,
  ], { timeout: 9000 });
  try {
    const data = JSON.parse(r.stdout.trim() || 'null');
    if (!data) return null;
    if (Array.isArray(data)) return data;
    if (Array.isArray(data.data)) return data.data;
    if (Array.isArray(data.models)) return data.models;
    return null;
  } catch {
    return null;
  }
}

/**
 * 模型列表：优先用 pi 里该 provider 可见的清单。
 *
 * 反代的 /v1/models 返回的是包作者按公开资料猜的静态表，与服务端真实可服务的 id
 * 对不上（例如 deepseek-v4.1-flash 能用但表里没有；表里的 claude-4.0 / gpt-5
 * 反而会被服务端拒绝）。pi 扩展读的是客户端落盘的产品配置，那份才是可用的，
 * 所以这里跟着 pi 走；pi 不可用时才退回反代的表。
 */
function opencodeModelsFromPi(provider) {
  if (!findCmd('pi')) return null;
  const listed = run('pi', ['--list-models'], { timeout: 180000 });
  if (listed.status !== 0) return null;
  const prefix = `${provider} `;
  const ids = [];
  for (const line of listed.stdout.split('\n')) {
    if (!line.startsWith(prefix)) continue;
    // 格式：provider  id  context  maxTokens  ...（id 里不会有空格）
    const id = line.slice(prefix.length).trim().split(/\s+/)[0];
    if (id) ids.push(id);
  }
  return ids.length ? ids : null;
}

/** 把 id 列表变成反代风格的模型条目，供共享模块转换。 */
function idsAsModels(ids) {
  return ids.map((id) => ({ id, name: id }));
}

/** 一个区域的全部账号共享同一个端点，所以 provider 只需要一份模型表。 */
function opencodeProviderSpec(base, models) {
  const provider = tuiProviderId();
  return {
    id: provider,
    name: REGION.key === 'global' ? 'WorkBuddy 国际版' : 'WorkBuddy 国内版',
    baseURL: `${base}/v1`,
    apiKey: 'workbuddy-local',
    models: opencode().toOpencodeModels(models),
  };
}

function opencode() {
  const mod = opencodeConfig();
  if (!mod) fail('找不到 opencode-config.js（重新运行安装脚本即可部署）');
  return mod;
}

function cmdOpencode(argv) {
  const action = (argv[0] || 'install').toLowerCase();
  const mod = opencode();
  const provider = tuiProviderId();
  const base = BASE;

  if (action === 'status') {
    const configured = mod.providerModelCount(provider);
    const models = proxyModels(base);
    console.log(`opencode 接入状态（${REGION.title}）`);
    console.log(`  配置文件 : ${mod.configPath()}`);
    console.log(`  端点     : ${base}/v1  ${models ? `[1;32m${G.ok}[0m 正常（${models.length} 个模型）` : `[1;31m${G.bad}[0m 不可达`}`);
    console.log(`  provider : ${configured === null ? '[1;33m未配置[0m（workbuddy2pi opencode install）' : `${provider}（${configured} 个模型）`}`);
    console.log(`  其它     : ${mod.listProviders().filter((p) => p !== provider).join(', ') || '（无）'}`);
    return 0;
  }

  if (action === 'install' || action === 'sync') {
    const fromPi = opencodeModelsFromPi(provider);
    const models = fromPi ? idsAsModels(fromPi) : proxyModels(base);
    if (!models || models.length === 0) {
      warn('拿不到模型列表，opencode 配置先不写（否则会指向一个没有模型的端点）');
      return 1;
    }
    if (fromPi) info(`模型列表取自 pi（${fromPi.length} 个），比反代的静态表更贴近服务端真实可用集`);
    else warn('pi 不可用，退回反代的模型表；那份表可能含服务端不认的 id');
    const result = mod.mergeProviders([opencodeProviderSpec(base, models)]);
    for (const a of result.added) ok(`${a.name}：已写入 ${a.models} 个模型（provider ${a.id}）`);
    if (result.backup) info(`原 opencode 配置已备份为 ${path.basename(result.backup)}`);
    ok(`已写入 ${result.path}`);
    console.log('');
    ok('完成。在 opencode 里这样用：');
    const sample = models.find((m) => /flash/i.test(m.id)) || models[0];
    console.log(`    opencode                然后 /models 选 ${provider}`);
    console.log(`    opencode run -m ${provider}/${sample.id} "你的问题"`);
    return 0;
  }

  if (action === 'uninstall') {
    if (mod.providerModelCount(provider) === null) {
      warn(`opencode 配置里本来就没有 ${provider}`);
      return 0;
    }
    // 只删这一个 provider 键，别的 provider 与顶层设置原样不动
    const file = mod.configPath();
    const cfg = readJson(file) || {};
    if (cfg.provider && cfg.provider[provider]) {
      delete cfg.provider[provider];
      const backup = `${file}.bak-${stamp()}`;
      if (fs.existsSync(file)) fs.copyFileSync(file, backup);
      fs.writeFileSync(file, `${JSON.stringify(cfg, null, 2)}
`);
      ok(`已从 opencode 配置里移除 ${provider}`);
    }
    return 0;
  }

  usage();
  return 1;
}

function usage() {
