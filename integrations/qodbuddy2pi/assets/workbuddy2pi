不带命令时进入交互界面（仅在真终端里；管道或重定向会退回纯文本 status）。
两个区域的服务、账号 slot 与日志完全独立，可以同时在线。

命令：
  status                 查看服务、端点、凭证与账号
  tui                    进入交互界面（不带命令时默认如此）
  start|stop|restart     控制常驻服务
  logs [行数]            查看反代日志尾部（默认 40 行）
  account                列出账号 slot
  account <key>          切换到指定账号
  account add            添加账号（浏览器登录建档）
  account remove <key>   删除账号（凭证留档为 <key>-removed-<日期>.json）
  account renew [key]    续期凭证（默认当前账号）
  login                  浏览器登录建档（与 account add 同一条路径）
  install-service        注册并启动常驻服务
  uninstall-service      移除常驻服务
  models                 查看模型（pi 可见的与本机反代在服务的）
  opencode install       把本机反代注册成 opencode 的 provider
  opencode status        看 opencode 侧的接入状态
  opencode uninstall     从 opencode 配置里移除（不动账号与凭证）
  doctor                 依赖与接入自检（失败时退出码非零）

例：
  workbuddy2pi                                国内版交互界面（总控第 2 页）
  workbuddy2pi global                         国际版交互界面（总控第 3 页）
  workbuddy2pi account b                      切到国内版账号 b
  workbuddy2pi global account add             添加一个国际版账号（浏览器登录）
  workbuddy2pi global account a               切到国际版账号 a
  workbuddy2pi global status                  查看国际版状态（纯文本，适合脚本）

供安装脚本调用（不宜手敲）：
  check-session          生效凭证有效则退出码 0，否则 1
  ensure-auth-key        保证 auth.json 里有 workbuddy 占位 key

平台：macOS 用 launchd，Linux 用 systemd --user，Windows 用登录触发的计划任务。
端口对应 pi 扩展里的 baseUrl：国内版 ${REGIONS.domestic.port} → provider workbuddy，
国际版 ${REGIONS.global.port} → provider workbuddy-global。`);
}

async function main() {
  const argv = process.argv.slice(2);
  // region 的来源：首参数的 global 子命令（别名入口已随 2.0.0 删掉，见 ADR 0005）。
  // 独立命令是给人用的，global 前缀留给脚本与旧习惯，两条都留。
  if ((process.env.WORKBUDDY_REGION || '').toLowerCase() === 'global') selectRegion('global');
  if ((argv[0] || '').toLowerCase() === 'global') {
    selectRegion('global');
    argv.shift();
  }

  // 不带子命令时进交互界面；管道或重定向时退回纯文本，避免把控制字符灌进文件
  if (!argv.length && process.stdout.isTTY && process.stdin.isTTY) return tuiMain();

  const cmd = (argv[0] || 'status').toLowerCase();

  switch (cmd) {
    case 'tui':
      return tuiMain();
    case 'status':
      return cmdStatus();
    case 'start':
      return startService();
    case 'stop':
      return stopService();
    case 'restart':
      return restartService();
    case 'logs':
      return cmdLogs(Number(argv[1]) > 0 ? Number(argv[1]) : 40);
    case 'install-service':
      return installService();
    case 'uninstall-service':
      return uninstallService();
    case 'doctor':
      return cmdDoctor();
    case 'models':
      return cmdModels().then((body) => { console.log(body); });
    case 'opencode':
      return process.exit(cmdOpencode(argv.slice(1)) || 0);
    case 'login':
      return cmdLogin();
    case 'check-session':
      return checkSession();
    case 'ensure-auth-key':
      return ensureAuthKey();
    case 'account': {
      const sub = argv[1];
      if (!sub) {
        const key = activeKey();
        const slots = listSlots();
        if (!slots.length) fail(`没有任何账号 slot，目录：${SLOTS_DIR}`);
        console.log('可用账号：');
        for (const s of slots) console.log(`  ${s.key === key ? '*' : ' '} ${describe(s)}`);
        return;
      }
      if (sub.toLowerCase() === 'renew') {
        const key = argv[2] || activeKey();
        if (!key) fail('无法判定当前账号，请显式指定要续期的 key');
        return renewSlot(key);
      }
      if (sub.toLowerCase() === 'add') return cmdAccountAdd();
      if (['remove', 'rm', 'del'].includes(sub.toLowerCase())) return cmdAccountRemove(argv[2]);
      return switchTo(sub);
    }
    case '-h':
    case '--help':
    case 'help':
      return usage();
    default:
      usage();
      fail(`未知子命令：${cmd}`);
  }
}

// 被 require 时不自动执行命令行入口，否则总控 qodbuddy2pi 一 require 就会把
// 自己的进程变成 CLI；qodbuddy2pi 这个总控只 require 它的页面定义。
function runCli() {
  main().catch((e) => fail(e && e.stack ? e.stack : String(e)));
}

module.exports = { workbuddyPage, REGIONS, runCli };

if (require.main === module) runCli();
