/**
 * 查看模型：两件事分开列——pi 里这个 provider 实际可见的模型，以及本机反代
 * 正在服务的模型。两者不一致就是问题所在（扩展没加载、模型目录读不到、
 * 或者反代上游没起来），所以并排看比只看一个数字有用。
 */
/**
 * 服务定义里写的是 wheel 的绝对路径，所以 wheel 一升级，已注册的服务仍然跑旧版本。
 * 这个检查把「服务定义引用的 wheel」与「当前应使用的 wheel」比一下，不一致就明说，
 * 免得升级后以为生效了、实际还在跑旧代码（国际版渠道校验就是这么被卡住的）。
 */
function staleServiceWheel() {
  const current = vendoredWheel();
  if (!current) return null;
  const definition = IS_MAC ? PLIST : IS_LINUX ? SYSTEMD_UNIT : SERVE_CMD;
  let text = '';
  try {
    text = fs.readFileSync(definition, 'utf8');
  } catch {
    return null; // 没注册服务就没什么可比的
  }
  const referenced = (text.match(/workbuddy2api-[0-9][^"'\s]*\.whl/) || [])[0];
  if (!referenced) return null;
  if (path.basename(current) === referenced) return null;
  return { referenced, current: path.basename(current) };
}

async function cmdModels() {
  const provider = tuiProviderId();
  const out = [];

  out.push(`pi 可见（provider ${provider}）`);
  if (findCmd('pi') || !IS_WIN) {
    const listed = run('pi', ['--list-models'], { timeout: 180000 });
    if (listed.status !== 0) {
      out.push('  读取失败：pi --list-models 没有正常退出');
    } else {
      const mine = listed.stdout.split('\n').filter((l) => l.startsWith(`${provider} `));
      if (!mine.length) {
        out.push('  0 个。确认扩展已加载（重开 pi），或先登录一个账号');
      } else {
        out.push(`  共 ${mine.length} 个`);
        for (const line of mine) out.push(`    ${line.trim()}`);
      }
    }
  } else {
    out.push('  未找到 pi');
  }

  out.push('');
  out.push(`反代在服务（${BASE}/v1/models）`);
  const h = await health();
  if (!h.ok) {
    out.push(`  不可用：${h.note}`);
  } else {
    out.push(`  共 ${h.models} 个`);
    for (const id of h.ids || []) out.push(`    ${id}`);
  }

  return out.join('\n');
}

async function cmdDoctor() {
  let bad = 0;
  const mark = (good, text, hint) => {
    if (good) ok(text);
    else {
      bad += 1;
      warn(`${text}${hint ? `　→ ${hint}` : ''}`);
    }
  };

  mark(true, `Node.js ${process.version}`);
  const uv = findUv();
  mark(!!uv, `uv：${uv || '未找到'}`, '运行安装器安装：qodbuddy2pi install');
  const wheel = vendoredWheel();
  mark(
    !!wheel,
    `vendored 反代依赖：${wheel ? path.basename(wheel) : '未找到'}`,
    '运行安装器部署：qodbuddy2pi install'
  );
  mark(fs.existsSync(LIVE), `生效凭证文件：${LIVE}`, '先完成登录建档');
  const live = readJson(LIVE);
  mark(!!(live && live.auth && live.auth.accessToken), '生效凭证含 accessToken');
  mark(!!(live && live.auth && live.auth.expiresAt), '生效凭证含 expiresAt（缺失会导致反代不再主动刷新）');
  mark(
    !!activeKey(),
    `生效凭证归属 slot：${activeKey() || '未匹配'}`,
    '用 workbuddy2pi account 查看可用 slot'
  );
  mark(fs.existsSync(EXTENSION), `pi 扩展：${EXTENSION}`, '运行安装脚本');
  const auth = readJson(AUTH_JSON) || {};
  mark(!!(auth.workbuddy && auth['workbuddy-global']), 'auth.json 中存在两个 provider 的占位 key',
    '运行安装脚本（缺 key 的 provider 会被 pi 整块丢弃）');

  const state = serviceStatus();
  mark(state.registered, `常驻服务：${state.detail}`, '运行 workbuddy2pi install-service');
  const h = await health();
  mark(h.ok, `端点：${h.ok ? `${h.models} 个模型` : h.note}`, '查看 workbuddy2pi logs');

  if (findCmd('pi') || !IS_WIN) {
    const listed = run('pi', ['--list-models'], { timeout: 120000 });
    const provider = REGION.key === 'global' ? 'workbuddy-global' : 'workbuddy';
    const count = listed.stdout.split('\n').filter((l) => l.startsWith(`${provider} `)).length;
    mark(count > 0, `pi 可见 ${provider} 模型：${count} 个`, '确认扩展已加载，并重开 pi');
  }

  console.log('');
  bad === 0 ? ok('自检全部通过') : warn(`自检有 ${bad} 项未通过`);
  if (bad > 0) process.exit(1);
}

