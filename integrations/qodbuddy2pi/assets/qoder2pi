function usage() {
  console.log(`qoder2pi — Qoder 接入 pi 与 opencode 的运维命令

用法：
  qoder2pi                       进入交互界面（不带参数且是终端时默认如此）
  qoder2pi status                查看 pi、扩展、两个区域与 opencode 代理的状态
  qoder2pi tui                   同上，显式进交互界面
  qoder2pi login <cn|global> [PAT]   用 PAT 登录；不给 PAT 时打印手动步骤
  qoder2pi logout <cn|global>    退出登录（auth.json 会先备份）
  qoder2pi install-extension     从本仓库的副本安装 pi-provider-qoder
  qoder2pi models                列出两个区域在 pi 里可见的模型
  qoder2pi doctor                自检（有失败项时退出码非零）

积分与签到（Qoder / Trae / WorkBuddy）：
  qoder2pi credits               余额与签到状态
  qoder2pi credits checkin       把能签的都签了
  qoder2pi credits json          以 JSON 输出（适合脚本）
  qoder2pi credits cn            只看某个区域

opencode：
  qoder2pi opencode install [cn|global]  起代理并写入 ~/.config/opencode/opencode.json
  qoder2pi opencode status               看 opencode 侧的接入状态
  qoder2pi opencode uninstall            从 opencode 配置里移除并停掉代理

代理（opencode 与其它 OpenAI 兼容客户端用的就是它）：
  qoder2pi proxy start [cn|global]       起代理（默认两个区域都起）
  qoder2pi proxy stop  [cn|global]       停代理
  qoder2pi proxy restart [cn|global]     重启
  qoder2pi proxy status                  看代理在不在
  qoder2pi proxy logs [cn|global] [n]    看代理日志尾部

两个区域并存，不需要二选一：国内版是 provider qoder-cn，国际版是 provider qoder。
PAT 获取：国内版 https://qoder.com.cn/account/integrations
          国际版 https://qoder.com/account/integrations

pi 直接用 Qoder 的私有协议（扩展 pi-provider-qoder），凭证在 ~/.pi/agent/auth.json。
opencode 只会说 OpenAI，所以中间有一个本机代理（qoder2pi proxy）做翻译；
它复用同一份 auth.json 凭证，因此两边共享同一份额度、同一份登录态。
国内版代理在 127.0.0.1:8789，国际版在 127.0.0.1:8790。`);
}

async function main() {
  const argv = process.argv.slice(2);

  // 不带子命令时进交互界面；管道或重定向时退回纯文本，避免把控制字符灌进文件
  if (!argv.length && process.stdout.isTTY && process.stdin.isTTY) return tuiMain();

  const cmd = (argv[0] || 'status').toLowerCase();
  const regionArg = (argv[1] || '').toLowerCase();

  const needRegion = () => {
    const key = REGION_ALIASES[regionArg];
    if (!key) fail(`请指定区域：cn 或 global（也可以用 provider 名 qoder-cn / qoder）`);
    return key;
  };

  switch (cmd) {
    case 'status':
      return cmdStatus();
    case 'tui':
      return tuiMain();
    case 'login':
      return process.exit(cmdLogin(needRegion(), argv[2]) || 0);
    case 'logout':
      return process.exit(cmdLogout(needRegion()) || 0);
    case 'install-extension':
      return process.exit(cmdInstallExtension() || 0);
    case 'models':
      console.log(cmdModels());
      return;
    case 'proxy':
      return process.exit(cmdProxy(argv.slice(1)) || 0);
    case 'credits':
    case 'quota':
      return cmdCredits(argv.slice(1)).then((code) => process.exit(code || 0));
    case 'opencode':
      return process.exit(cmdOpencode(argv.slice(1)) || 0);
    case 'doctor':
      return cmdDoctor();
    case '-h':
    case '--help':
    case 'help':
      return usage();
    default:
      usage();
      fail(`未知子命令：${cmd}`);
  }
}

// 被 require 时（总控 qodbuddy2pi）只导出页定义，不执行命令行入口
module.exports = { qoderPage };

if (require.main === module) main().catch((e) => fail(e && e.stack ? e.stack : String(e)));
