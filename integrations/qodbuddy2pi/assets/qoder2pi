#!/usr/bin/env node
/**
 * qoder2pi — Qoder 接入 pi 的运维命令。
 *
 * 与 WorkBuddy 那边不同，Qoder 没有本机反代服务：一切都由 pi 扩展
 * pi-provider-qoder 负责，登录凭证直接落在 pi 自己的 ~/.pi/agent/auth.json。
 * 所以这里管的是「两个区域各自的登录状态、扩展、模型」，没有端口、没有服务、
 * 也没有账号切换——国内版与国际版是并存的，不需要二选一。
 *
 * 界面本体是 ./tui.js（与 workbuddy2pi、安装向导共用同一套）。
 */

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const readline = require('readline');
const { spawnSync, execFile } = require('child_process');
const { C, G, findCmd, resolveSpawn, readJson, AUTH_JSON } = require('./tui');

const HOME = os.homedir();
const CONFIG = path.join(HOME, '.qoder2pi', 'config.json');

/**
 * opencode 侧要落地的东西：代理本体、opencode 配置、pid/日志目录。
 *
 * 为什么要一个代理：opencode 只会说 OpenAI，Qoder 只认它自己的 COSY 网关协议。
 * 代理（assets/qoder-proxy.js）在中间做翻译，并复用 pi 的 auth.json 凭证，
 * 于是 pi 与 opencode 共享同一份额度、同一份登录态。
 */
const OPENCODE_DIR = path.join(HOME, '.config', 'opencode');
const OPENCODE_JSON = path.join(OPENCODE_DIR, 'opencode.json');
const PROXY_DIR = path.join(HOME, '.qoder2pi', 'proxy');
const PROXY_JS = path.join(HOME, '.qoder2pi', 'vendor', 'qoder-proxy.js');

/** pi 扩展的部署目录：一个子目录放 index.ts + quota.js（pi 认 index.ts 作入口）。 */
const EXT_DIR = path.join(HOME, '.pi', 'agent', 'extensions', 'qodbuddy2pi');

/** 两个区域各自一个实例，端口固定（与 workbuddy 那边的 8787/8788 同一套思路）。 */
const PROXY = {
  cn: { key: 'cn', port: 8789, provider: 'qoder-cn', title: '国内版', suffix: '' },
  global: { key: 'global', port: 8790, provider: 'qoder', title: '国际版', suffix: '-global' },
};

const IS_MAC = process.platform === 'darwin';
const IS_LINUX = process.platform === 'linux';
const IS_WIN = process.platform === 'win32';

const USER = (() => {
  try {
    return os.userInfo().username;
  } catch {
    return process.env.USER || process.env.USERNAME || 'user';
  }
})();

/**
 * 代理的服务名。与 workbuddy2api 一致：服务名带上区域后缀，两个区域能同时在线。
 */
function serviceNames(regionKey) {
  const region = PROXY[regionKey];
  return {
    label: `com.${USER}.qoder2pi-proxy${region.suffix}`,
    unit: `qoder2pi-proxy${region.suffix}`,
    task: `qoder2pi-proxy${region.suffix}`,
    plist: path.join(HOME, 'Library', 'LaunchAgents', `com.${USER}.qoder2pi-proxy${region.suffix}.plist`),
    systemdUnit: path.join(HOME, '.config', 'systemd', 'user', `qoder2pi-proxy${region.suffix}.service`),
    serveCmd: path.join(PROXY_DIR, `serve${region.suffix}.cmd`),
  };
}

/**
 * 两个区域是两份独立登录态，对应 pi 里两个 provider。PAT 走不同的环境变量，
 * 扩展收到后会自动兑换 token 并写进 auth.json。
 */
const REGIONS = {
  cn: {
    key: 'cn',
    title: '国内版',
    provider: 'qoder-cn',
    patEnv: 'QODERCN_API_KEY',
    patPage: 'https://qoder.com.cn/account/integrations',
  },
  global: {
    key: 'global',
    title: '国际版',
    provider: 'qoder',
    patEnv: 'QODER_API_KEY',
    patPage: 'https://qoder.com/account/integrations',
  },
};

/** 用户可能按 provider 名来指代区域，两种写法都认。 */
const REGION_ALIASES = {
  cn: 'cn',
  'qoder-cn': 'cn',
  global: 'global',
  qoder: 'global',
};

const ok = (m) => console.log(`\x1b[1;32m✓\x1b[0m ${m}`);
const info = (m) => console.log(`\x1b[1;36m==>\x1b[0m ${m}`);
const warn = (m) => console.log(`\x1b[1;33m!\x1b[0m ${m}`);
const fail = (m) => {
  console.error(`\x1b[1;31m错误:\x1b[0m ${m}`);
  process.exit(1);
};

// ---------------------------------------------------------------- 基础工具

function run(cmd, args, opts = {}) {
  // Windows 上 pi 是 pi.cmd，spawn 不能直接跑，resolveSpawn 会包一层 cmd.exe
  const sp = resolveSpawn(cmd, args);
  const r = spawnSync(sp.cmd, sp.args, { encoding: 'utf8', timeout: opts.timeout || 60000, ...opts });
  return {
    status: r.status === null ? -1 : r.status,
    stdout: (r.stdout || '').trim(),
    stderr: (r.stderr || '').trim(),
    error: r.error,
  };
}

function fmtTime(ms) {
  if (!ms) return '未知';
  const d = new Date(Number(ms));
  const pad = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function stamp() {
  const d = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
}

function hasPi() {
  // 不能用 sh -c 'command -v': Windows 原生没 sh，会把已装的 pi 误判成未装
  return !!findCmd('pi');
}

// ---------------------------------------------------------------- 登录态

/** 该区域的登录条目；只有 access 存在才算已登录。 */
function authEntry(region) {
  const entry = (readJson(AUTH_JSON) || {})[region.provider];
  return entry && entry.access ? entry : null;
}

/**
 * 登录状态文案。expires 是毫秒时间戳；过期不等于失效——扩展会拿 refresh 自动续。
 */
function loginState(region) {
  const entry = authEntry(region);
  if (!entry) return { loggedIn: false, note: '未登录' };
  const ms = Number(entry.expires || 0);
  const who = entry.userID ? `userID ${String(entry.userID).slice(0, 8)}…` : '已登录';
  if (!ms) return { loggedIn: true, note: `已登录（${who}，到期时间未知）` };
  const days = Math.floor((ms - Date.now()) / 86400000);
  if (days < 0) return { loggedIn: true, note: `已登录（${who}，access 已于 ${fmtTime(ms)} 过期，扩展会自动续期）` };
  return { loggedIn: true, note: `已登录（${who}，access 剩 ${days} 天）` };
}

/** 异步版子进程：界面刷新用。同步版会阻塞事件循环，把界面冻住。 */
function runAsync(cmd, args, opts = {}) {
  return new Promise((resolve) => {
    const sp = resolveSpawn(cmd, args);
    execFile(sp.cmd, sp.args, { encoding: 'utf8', timeout: opts.timeout || 60000, maxBuffer: 32 * 1024 * 1024 }, (error, stdout, stderr) => {
      resolve({
        status: error ? -1 : 0,
        stdout: (stdout || '').trim(),
        stderr: (stderr || '').trim(),
        error,
      });
    });
  });
}

/**
 * 一次拿到两个 provider 的模型行，按 provider 分组。
 *
 * pi --list-models 要跑 0.6 秒左右，而它的输出本来同时包含两个区域；
 * 之前每个区域各调一次，等于白花一倍时间。
 */
function listAllModels() {
  if (!hasPi()) return null;
  const r = run('pi', ['--list-models'], { timeout: 180000 });
  if (r.status !== 0) return null;
  const out = { cn: [], global: [] };
  for (const line of r.stdout.split('\n')) {
    if (line.startsWith('qoder-cn ')) out.cn.push(line);
    else if (line.startsWith('qoder ')) out.global.push(line);
  }
  return out;
}

/** 异步、不阻塞事件循环的版本；界面刷新用这个，否则界面会冻住。 */
async function listAllModelsAsync() {
  const [version, listed, models] = await Promise.all([
    runAsync('pi', ['--version']),
    runAsync('pi', ['list']),
    runAsync('pi', ['--list-models'], { timeout: 180000 }),
  ]);
  const out = { cn: [], global: [], version: version.stdout, extension: listed.stdout.includes('pi-provider-qoder') };
  if (models.status === 0) {
    for (const line of models.stdout.split('\n')) {
      if (line.startsWith('qoder-cn ')) out.cn.push(line);
      else if (line.startsWith('qoder ')) out.global.push(line);
    }
  } else {
    return null;
  }
  return out;
}

/** pi 里该 provider 的模型行；pi 不可用时返回 null。 */
function listModels(region) {
  const all = listAllModels();
  if (all === null) return null;
  return all[region.key === 'cn' ? 'cn' : 'global'];
}

function extensionPath() {
  const cfg = readJson(CONFIG);
  const vendor = cfg && cfg.vendorQoder;
  return vendor && fs.existsSync(path.join(vendor, 'package.json')) ? vendor : null;
}

function extensionInstalled() {
  return run('pi', ['list']).stdout.includes('pi-provider-qoder');
}

// ---------------------------------------------------------------- 命令

function cmdStatus() {
  console.log('Qoder 接入状态');
  console.log(`  pi        : ${hasPi() ? run('pi', ['--version']).stdout || '可用' : '\x1b[1;31m未找到\x1b[0m'}`);
  const vendor = extensionPath();
  console.log(
    `  扩展      : ${extensionInstalled() ? 'pi-provider-qoder 已安装' : `\x1b[1;33m未安装\x1b[0m`}` +
      (vendor ? `（扩展副本 ${path.relative(HOME, vendor)}）` : `（${CONFIG} 里没有记录扩展副本路径）`)
  );
  console.log(`  凭证文件  : ${fs.existsSync(AUTH_JSON) ? AUTH_JSON : `\x1b[1;33m${AUTH_JSON} 不存在\x1b[0m`}`);
  console.log('');
  for (const region of Object.values(REGIONS)) {
    const st = loginState(region);
    const mark = st.loggedIn ? `${C.green}${G.running}${C.reset}` : `${C.yellow}${G.idle}${C.reset}`;
    console.log(`  ${mark} ${region.title}（provider ${region.provider}）`);
    console.log(`      ${st.note}`);
    const models = listModels(region);
    if (models === null) console.log('      模型：无法读取（pi 不可用）');
    else if (!models.length) console.log('      模型：无（未登录或扩展未加载）');
    else console.log(`      模型：${models.length} 个`);
    // opencode 侧的状态就接在同一个区域下面：两边共用量，状态放一起看最顺
    const proxy = proxyStatus(region.key);
    console.log(`      opencode：${proxy.healthy ? `代理运行中，http://127.0.0.1:${proxy.region.port}/v1` : '代理未运行（qoder2pi proxy start）'}`);
  }
}

function cmdLogin(regionKey, patArg) {
  const region = REGIONS[regionKey];
  const pat = patArg || process.env.QODER_PAT || '';
  if (!pat) {
    console.log(`为 ${region.title}（provider ${region.provider}）登录：`);
    console.log(`  1. 打开 ${region.patPage}，创建一个 PAT（pt- 开头）`);
    console.log(`  2. 执行 qoder2pi login ${region.key} pt-xxxxxx`);
    console.log(`     也可以跑 pi，在里面输入 /login ${region.provider}`);
    return 0;
  }
  if (!hasPi()) fail('未找到 pi，请先运行仓库的安装脚本');
  info(`用 PAT 登录 ${region.title}（provider ${region.provider}）…`);
  // 扩展在启动时读到该环境变量就会兑换 token 并写入 auth.json，所以这里跑一次
  // --list-models 即可，不需要进入交互界面。
  const env = { ...process.env, [region.patEnv]: pat };
  const sp = resolveSpawn('pi', ['--provider', region.provider, '--list-models']);
  const r = spawnSync(sp.cmd, sp.args, { env, encoding: 'utf8', timeout: 180000 });
  if (authEntry(region)) {
    ok(`已登录：${loginState(region).note}`);
    return 0;
  }
  warn('环境变量登录没有生效。');
  const detail = `${(r.stdout || '').trim()}\n${(r.stderr || '').trim()}`.trim();
  if (detail) console.log(detail.split('\n').slice(-5).join('\n'));
  console.log(`      请跑 pi，在里面输入 /login ${region.provider} 手动登录`);
  return 1;
}

function cmdLogout(regionKey) {
  const region = REGIONS[regionKey];
  const data = readJson(AUTH_JSON);
  if (!data || !data[region.provider]) {
    warn(`${region.title} 本来就没有登录凭据`);
    return 0;
  }
  const backup = `${AUTH_JSON}.bak-${stamp()}`;
  fs.copyFileSync(AUTH_JSON, backup);
  delete data[region.provider];
  fs.writeFileSync(AUTH_JSON, `${JSON.stringify(data, null, 2)}\n`);
  ok(`已退出 ${region.title}`);
  info(`原凭证已备份为 ${backup}`);
  return 0;
}

function cmdInstallExtension() {
  const vendor = extensionPath();
  if (!vendor) {
    fail(`找不到扩展副本：${CONFIG} 里没有有效的 vendorQoder 路径。请重新运行安装脚本（qodbuddy2pi install）`);
  }
  if (extensionInstalled()) {
    ok('pi-provider-qoder 已安装。要重装请先 pi uninstall pi-provider-qoder 再执行本命令');
    return 0;
  }
  info(`从扩展副本安装：${vendor}`);
  const r = run('pi', ['install', vendor], { timeout: 300000, stdio: 'inherit' });
  if (r.status !== 0) fail('pi install 失败');
  ok('扩展已安装');
  return 0;
}

// ---------------------------------------------------------------- 代理（opencode 用）

function proxyLogFile(regionKey) {
  return path.join(PROXY_DIR, `${regionKey}.log`);
}

/**
 * 找出监听某个本机端口的进程。
 *
 * Windows 上必须有这一步：计划任务的 /End 只结束 cmd.exe 包装进程，
 * .cmd 里那个循环拉起的 node 会继续活着并占着端口。netstat 输出的最后一列
 * 是 PID，与系统语言无关，所以按它取。
 */
function portPid(port) {
  if (IS_WIN) {
    const r = run('netstat', ['-ano', '-p', 'TCP']);
    for (const line of r.stdout.split('\n')) {
      const cols = line.trim().split(/\s+/);
      if (cols.length < 5) continue;
      if (!cols[1].endsWith(`:${port}`)) continue;
      if (cols[3] !== 'LISTENING') continue;
      const pid = Number(cols[4]);
      if (Number.isFinite(pid) && pid > 0) return pid;
    }
    return null;
  }
  const r = run('lsof', ['-nP', `-iTCP:${port}`, '-sTCP:LISTEN', '-t']);
  const pid = Number(r.stdout.split('\n')[0]);
  return Number.isFinite(pid) && pid > 0 ? pid : null;
}

function killPid(pid) {
  if (!pid) return;
  if (IS_WIN) {
    run('taskkill', ['/PID', String(pid), '/T', '/F']);
    return;
  }
  try {
    process.kill(pid, 'SIGTERM');
  } catch {
    // 已经退出了
  }
}

/** 探 /health：比看 pid 准，因为 pid 可能被复用。 */
function proxyHealthy(regionKey) {
  const port = PROXY[regionKey].port;
  const r = run('node', [
    '-e',
    `fetch('http://127.0.0.1:${port}/health',{signal:AbortSignal.timeout(800)}).then(r=>r.ok).then(ok=>{process.stdout.write(ok?'ok':'no')}).catch(()=>process.stdout.write('no'))`,
  ], { timeout: 5000 });
  return r.stdout.trim() === 'ok';
}

function proxyStatus(regionKey) {
  const region = PROXY[regionKey];
  const healthy = proxyHealthy(regionKey);
  return { region, healthy, service: serviceStatus(regionKey) };
}

/** 等 /health 变 ok。代理启动要读凭证、拉模型目录，给 8 秒。 */
function waitProxyHealthy(regionKey, timeoutMs = 8000) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    if (proxyHealthy(regionKey)) return true;
    sleepMs(250);
  }
  return false;
}

/** 同步睡眠：不拉外部 sleep/timeout 命令，跨平台且不过 shell。 */
function sleepMs(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

/**
 * 拉起一个区域的代理。detached + unref 让代理活过当前命令：
 * qoder2pi proxy start 返回之后 opencode 才去连它。
 */
// ---------------------------------------------------------------- 常驻服务
//
// 代理不是一次性的前台进程，而是一个开机就在、崩溃自恢复的常驻服务：opencode
// 会在任何时候发请求，代理不在就静默 401。这里与 WorkBuddy 那边用同一套做法，
// macOS 用 launchd、Linux 用 systemd --user、Windows 用登录触发的计划任务。

function launchdDomain() {
  return `gui/${process.getuid()}`;
}

/** 卸下 launchd job 并等标签真的消失（bootout 是异步的，不等会撞 Bootstrap failed）。 */
function launchdBootout(label, plistPath) {
  run('launchctl', ['bootout', `${launchdDomain()}/${label}`]);
  const deadline = Date.now() + 5000;
  while (Date.now() < deadline) {
    if (run('launchctl', ['print', `${launchdDomain()}/${label}`]).status !== 0) return true;
    sleepMs(200);
  }
  return false;
}

function launchdPlist(regionKey) {
  const names = serviceNames(regionKey);
  const region = PROXY[regionKey];
  const stdout = proxyLogFile(regionKey);
  return `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>${names.label}</string>
	<!-- 由 launchd 直接托管 node（而不是让脚本 nohup 到后台），
		这样 KeepAlive 才能在崩溃后把代理拉回来。 -->
	<key>ProgramArguments</key>
	<array>
		<string>${process.execPath}</string>
		<string>${PROXY_JS}</string>
		<string>--region</string>
		<string>${regionKey}</string>
		<string>--port</string>
		<string>${region.port}</string>
		<string>--log-file</string>
		<string>${proxyLogFile(regionKey)}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${HOME}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>${HOME}</string>
		<key>PATH</key>
		<string>${path.join(HOME, '.local', 'bin')}:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>StandardOutPath</key>
	<string>${stdout}</string>
	<key>StandardErrorPath</key>
	<string>${stdout}</string>
</dict>
</plist>
`;
}

function systemdUnitFile(regionKey) {
  const names = serviceNames(regionKey);
  const region = PROXY[regionKey];
  return `[Unit]
Description=Qoder OpenAI 兼容代理（把 ${region.title} 的额度转成 OpenAI 端点）
After=network-online.target

[Service]
Type=simple
ExecStart=${process.execPath} ${PROXY_JS} --region ${regionKey} --port ${region.port} --log-file ${proxyLogFile(regionKey)}
WorkingDirectory=${HOME}
Restart=always
RestartSec=15
StandardOutput=append:${proxyLogFile(regionKey)}
StandardError=append:${proxyLogFile(regionKey)}

[Install]
WantedBy=default.target
`;
}

function windowsServeCmd(regionKey) {
  const region = PROXY[regionKey];
  const log = proxyLogFile(regionKey);
  // 计划任务不会在崩溃后重启进程，所以用循环做 keep-alive。
  // 行尾必须是 CRLF：cmd.exe 解析只有 LF 的 .cmd 时 goto 会找不到标签。
  return [
    '@echo off',
    'rem 由 qoder2pi 生成，请勿手工编辑。',
    'setlocal',
    ':loop',
    `"${process.execPath}" "${PROXY_JS}" --region ${regionKey} --port ${region.port} --log-file "${log}" >> "${log}" 2>&1`,
    'timeout /t 15 /nobreak >nul',
    'goto loop',
    '',
  ].join('\r\n');
}

/** 服务注册状态。与 workbuddy2pi 一样，运行与否以 /health 为准，不信计划任务的状态文本。 */
function serviceStatus(regionKey) {
  const names = serviceNames(regionKey);
  if (IS_MAC) {
    const r = run('launchctl', ['print', `${launchdDomain()}/${names.label}`]);
    if (r.status !== 0) return { registered: false, detail: '未注册' };
    const state = (r.stdout.match(/^\s*state = (\S+)/m) || [])[1] || 'unknown';
    return { registered: true, detail: `launchd ${names.label}，state=${state}` };
  }
  if (IS_LINUX) {
    const enabled = run('systemctl', ['--user', 'is-enabled', names.unit]);
    return { registered: enabled.status === 0, detail: `systemd --user ${names.unit}，is-enabled=${enabled.stdout || '未知'}` };
  }
  const q = run('schtasks', ['/Query', '/TN', names.task]);
  return { registered: q.status === 0, detail: q.status === 0 ? `计划任务 ${names.task}（登录时启动）` : '未注册' };
}

function installService(regionKey, { quiet = false } = {}) {
  const names = serviceNames(regionKey);
  const region = PROXY[regionKey];
  if (!fs.existsSync(PROXY_JS)) {
    fail(`找不到代理脚本 ${PROXY_JS}。重新运行安装脚本（qodbuddy2pi install）`);
  }
  fs.mkdirSync(PROXY_DIR, { recursive: true });

  if (IS_MAC) {
    fs.mkdirSync(path.dirname(names.plist), { recursive: true });
    fs.writeFileSync(names.plist, launchdPlist(regionKey));
    launchdBootout(names.label, names.plist);
    const r = run('launchctl', ['bootstrap', launchdDomain(), names.plist]);
    if (r.status !== 0) fail(`launchctl bootstrap 失败：${r.stderr || r.stdout}`);
    if (!quiet) ok(`${region.title}：已注册 launchd 服务 ${names.label}`);
    return 0;
  }
  if (IS_LINUX) {
    fs.mkdirSync(path.dirname(names.systemdUnit), { recursive: true });
    fs.writeFileSync(names.systemdUnit, systemdUnitFile(regionKey));
    run('systemctl', ['--user', 'daemon-reload']);
    const r = run('systemctl', ['--user', 'enable', '--now', names.unit]);
    if (r.status !== 0) fail(`systemctl enable --now 失败：${r.stderr || r.stdout}`);
    if (!quiet) ok(`${region.title}：已注册并启用 systemd 用户服务 ${names.unit}`);
    if (run('loginctl', ['show-user', USER, '-p', 'Linger']).stdout.includes('Linger=no')) {
      warn('未开启 linger，注销登录后代理会停止。可执行：loginctl enable-linger ' + USER);
    }
    return 0;
  }
  fs.writeFileSync(names.serveCmd, windowsServeCmd(regionKey));
  const r = run('schtasks', [
    '/Create', '/TN', names.task, '/TR', `"${names.serveCmd}"`, '/SC', 'ONLOGON', '/RL', 'LIMITED', '/F',
  ]);
  if (r.status !== 0) fail(`schtasks /Create 失败：${r.stderr || r.stdout}`);
  run('schtasks', ['/Run', '/TN', names.task]);
  if (!quiet) ok(`${region.title}：已注册计划任务 ${names.task}（登录时启动）`);
  return 0;
}

function uninstallService(regionKey, { quiet = false } = {}) {
  const names = serviceNames(regionKey);
  const region = PROXY[regionKey];
  if (IS_MAC) {
    launchdBootout(names.label, names.plist);
    if (fs.existsSync(names.plist)) fs.unlinkSync(names.plist);
    if (!quiet) ok(`${region.title}：已移除 launchd 服务`);
    return 0;
  }
  if (IS_LINUX) {
    run('systemctl', ['--user', 'disable', '--now', names.unit]);
    if (fs.existsSync(names.systemdUnit)) fs.unlinkSync(names.systemdUnit);
    run('systemctl', ['--user', 'daemon-reload']);
    if (!quiet) ok(`${region.title}：已移除 systemd 用户服务`);
    return 0;
  }
  run('schtasks', ['/End', '/TN', names.task]);
  run('schtasks', ['/Delete', '/TN', names.task, '/F']);
  if (fs.existsSync(names.serveCmd)) fs.unlinkSync(names.serveCmd);
  if (!quiet) ok(`${region.title}：已移除计划任务`);
  return 0;
}

/** 已注册就拉起，没注册就先注册。 */
function startProxy(regionKey, { quiet = false } = {}) {
  const region = PROXY[regionKey];
  const names = serviceNames(regionKey);
  const state = serviceStatus(regionKey);
  if (!state.registered) return installService(regionKey, { quiet });

  if (IS_MAC) {
    const r = run('launchctl', ['kickstart', `${launchdDomain()}/${names.label}`]);
    if (r.status !== 0) return installService(regionKey, { quiet });
  } else if (IS_LINUX) {
    const r = run('systemctl', ['--user', 'start', names.unit]);
    if (r.status !== 0) fail(`systemctl start 失败：${r.stderr || r.stdout}`);
  } else {
    const r = run('schtasks', ['/Run', '/TN', names.task]);
    if (r.status !== 0) fail(`schtasks /Run 失败：${r.stderr || r.stdout}`);
  }
  if (!waitProxyHealthy(regionKey)) {
    warn(`${region.title}：代理没能在 8 秒内起来，日志：${proxyLogFile(regionKey)}`);
    return 1;
  }
  if (!quiet) ok(`${region.title}：代理已启动，http://127.0.0.1:${region.port}/v1`);
  return 0;
}

function stopProxy(regionKey, { quiet = false } = {}) {
  const region = PROXY[regionKey];
  const names = serviceNames(regionKey);
  const registered = serviceStatus(regionKey).registered;
  // 先记下端口上的进程：停服务后包装进程可能已经没了，但子进程还在
  const pid = portPid(region.port);
  if (registered) {
    if (IS_MAC) {
      if (!launchdBootout(names.label, names.plist)) warn('launchd job 未能在预期时间内卸下');
    } else if (IS_LINUX) {
      const r = run('systemctl', ['--user', 'stop', names.unit]);
      if (r.status !== 0) fail(`systemctl stop 失败：${r.stderr || r.stdout}`);
    } else {
      const r = run('schtasks', ['/End', '/TN', names.task]);
      if (r.status !== 0) fail(`schtasks /End 失败：${r.stderr || r.stdout}`);
    }
  }
  // Windows 上 /End 不会结束 .cmd 循环拉起的 node，必须按端口把它收掉
  killPid(pid || portPid(region.port));
  const deadline = Date.now() + 3000;
  while (Date.now() < deadline && proxyHealthy(regionKey)) sleepMs(150);
  if (!quiet) ok(`${region.title}：代理已停止`);
  return 0;
}

function restartProxy(regionKey, { quiet = false } = {}) {
  const names = serviceNames(regionKey);
  if (!serviceStatus(regionKey).registered) return startProxy(regionKey, { quiet });
  if (IS_MAC) {
    const r = run('launchctl', ['kickstart', '-k', `${launchdDomain()}/${names.label}`]);
    if (r.status !== 0) return startProxy(regionKey, { quiet });
  } else if (IS_LINUX) {
    const r = run('systemctl', ['--user', 'restart', names.unit]);
    if (r.status !== 0) fail(`systemctl restart 失败：${r.stderr || r.stdout}`);
  } else {
    run('schtasks', ['/End', '/TN', names.task]);
    // 与 stopProxy 同理：计划任务不会带走 node 子进程，得按端口自己收
    killPid(portPid(PROXY[regionKey].port));
    sleepMs(1000);
    const r = run('schtasks', ['/Run', '/TN', names.task]);
    if (r.status !== 0) fail(`schtasks /Run 失败：${r.stderr || r.stdout}`);
  }
  if (!quiet) ok(`${PROXY[regionKey].title}：代理已重启`);
  return 0;
}

function cmdProxy(argv) {
  const action = (argv[0] || 'status').toLowerCase();
  const regionKey = REGION_ALIASES[(argv[1] || '').toLowerCase()];
  const targets = regionKey ? [regionKey] : ['cn', 'global'];

  if (action === 'status') {
    for (const key of targets) {
      const st = proxyStatus(key);
      const mark = st.healthy ? `${C.green}${G.running}${C.reset}` : `${C.yellow}${G.idle}${C.reset}`;
      const svc = st.service.registered ? st.service.detail : '未注册';
      console.log(`${mark} ${st.region.title}  http://127.0.0.1:${st.region.port}/v1  ${st.healthy ? '运行中' : '未运行'}  ·  ${svc}`);
    }
    return 0;
  }
  if (action === 'start' || action === 'restart') {
    let bad = 0;
    for (const key of targets) {
      bad += (action === 'restart' ? restartProxy(key) : startProxy(key)) === 0 ? 0 : 1;
    }
    return bad ? 1 : 0;
  }
  if (action === 'stop') {
    let bad = 0;
    for (const key of targets) bad += stopProxy(key) === 0 ? 0 : 1;
    return bad ? 1 : 0;
  }
  if (action === 'install-service') {
    let bad = 0;
    for (const key of targets) bad += installService(key) === 0 ? 0 : 1;
    return bad ? 1 : 0;
  }
  if (action === 'uninstall-service') {
    let bad = 0;
    for (const key of targets) bad += uninstallService(key) === 0 ? 0 : 1;
    return bad ? 1 : 0;
  }
  if (action === 'logs') {
    const n = Number(argv[2]) || 50;
    for (const key of targets) {
      const file = proxyLogFile(key);
      console.log(`\n[${PROXY[key].title}] ${file}`);
      if (!fs.existsSync(file)) {
        console.log('  （没有日志）');
        continue;
      }
      const lines = fs.readFileSync(file, 'utf8').trimEnd().split('\n');
      console.log(lines.slice(-n).join('\n') || '  （空）');
    }
    return 0;
  }
  usage();
  return 1;
}

// ---------------------------------------------------------------- opencode

/**
 * 问代理要模型目录。代理没起来时返回 null——opencode 配置就不写模型清单，
 * 让用户先跑 qoder2pi proxy start。
 */
/**
 * 模型列表与配置合并都交给 opencode-config.js：Trae / WorkBuddy 也要往同一份
 * opencode 配置里写 provider，各写一份必然漂移。
 */
function oc() {
  return require('./opencode-config.js');
}

/** 同步版本：子命令是同步流程，用 node -e 探一下代理。 */
function fetchProxyModels(regionKey) {
  const port = PROXY[regionKey].port;
  const r = run('node', [
    '-e',
    `fetch('http://127.0.0.1:${port}/v1/models',{signal:AbortSignal.timeout(5000)}).then(r=>r.json()).then(d=>process.stdout.write(JSON.stringify(d))).catch(()=>process.stdout.write('null'))`,
  ], { timeout: 8000 });
  try {
    const data = JSON.parse(r.stdout.trim() || 'null');
    return data && Array.isArray(data.data) ? data.data : null;
  } catch {
    return null;
  }
}

/**
 * 写 opencode.json。
 *
 * 只碰 provider 里自己那两个键，别的 provider（trae-local、siliconflow…）原样保留，
 * 也不动 model / plugins 这些顶层设置。已有的 opencode.json 先备份一次。
 */
function writeOpencodeConfig(regions) {
  const providers = [];
  for (const regionKey of regions) {
    const region = PROXY[regionKey];
    const models = fetchProxyModels(regionKey);
    if (!models || models.length === 0) {
      warn(`${region.title}：代理没在跑，拿不到模型列表，跳过`);
      continue;
    }
    providers.push({
      id: region.provider,
      name: `Qoder ${region.title}`,
      baseURL: `http://127.0.0.1:${region.port}/v1`,
      apiKey: 'qoder-local',
      models: oc().toOpencodeModels(models),
    });
  }
  if (providers.length === 0) return 1;
  const result = oc().mergeProviders(providers);
  for (const a of result.added) ok(`${a.name}：已写入 ${a.models} 个模型（provider ${a.id}）`);
  if (result.backup) info(`原 opencode 配置已备份为 ${path.basename(result.backup)}`);
  ok(`已写入 ${result.path}`);
  return 0;
}

function opencodeInstalled() {
  return !!findCmd('opencode');
}

function cmdOpencode(argv) {
  const action = (argv[0] || 'install').toLowerCase();

  if (action === 'status') {
    console.log('opencode 接入状态');
    console.log(`  opencode : ${opencodeInstalled() ? `${C.green}${G.ok}${C.reset} ${run('opencode', ['--version']).stdout || '可用'}` : `${C.yellow}${G.idle}${C.reset} 未找到（https://opencode.ai）`}`);
    console.log(`  配置文件 : ${fs.existsSync(OPENCODE_JSON) ? OPENCODE_JSON : `${C.yellow}${OPENCODE_JSON} 不存在${C.reset}`}`);
    console.log(`  代理脚本 : ${fs.existsSync(PROXY_JS) ? PROXY_JS : `${C.yellow}${PROXY_JS} 不存在${C.reset}`}`);
    console.log('');
    for (const key of ['cn', 'global']) {
      const region = PROXY[key];
      const st = loginState(REGIONS[key]);
      const cfg = (readJson(OPENCODE_JSON) || {}).provider || {};
      const entry = cfg[region.provider];
      const proxy = proxyStatus(key);
      const mark = st.loggedIn ? `${C.green}${G.running}${C.reset}` : `${C.yellow}${G.idle}${C.reset}`;
      console.log(`  ${mark} ${region.title}（provider ${region.provider}）`);
      console.log(`      pi 登录  : ${st.note}`);
      console.log(`      代理     : ${proxy.healthy ? `运行中 http://127.0.0.1:${region.port}/v1` : '未运行'}`);
      console.log(`      opencode : ${entry ? `已配置 ${Object.keys(entry.models || {}).length} 个模型` : '未配置'}`);
    }
    return 0;
  }

  if (action === 'install' || action === 'sync') {
    const only = (argv[1] || '').toLowerCase();
    const regionKey = only ? REGION_ALIASES[only] : null;
    const keys = regionKey ? [regionKey] : ['cn', 'global'];

    // 只处理在 pi 里登录过的区域：没登录时写进 opencode 也只会报 401
    const loggedIn = keys.filter((k) => loginState(REGIONS[k]).loggedIn);
    if (loggedIn.length === 0) {
      warn('pi 里还没有登录任何 Qoder 区域，先跑 qoder2pi login cn pt-xxxxxx');
      return 1;
    }
    // 代理脚本部署到 ~/.qoder2pi/vendor，安装脚本会复制；源码仓库里直接跑时用仓库那份
    if (!fs.existsSync(PROXY_JS)) {
      const local = path.join(__dirname, 'qoder-proxy.js');
      if (fs.existsSync(local)) {
        fs.mkdirSync(path.dirname(PROXY_JS), { recursive: true });
        fs.copyFileSync(local, PROXY_JS);
        info(`已部署代理脚本 ${PROXY_JS}`);
      } else {
        fail(`找不到 qoder-proxy.js（既不在 ${PROXY_JS}，也不在 ${local}）`);
      }
    }
    let bad = 0;
    for (const key of loggedIn) bad += startProxy(key) === 0 ? 0 : 1;
    if (bad) {
      warn('有代理没起来，opencode 配置先不写（否则会指向一个死端口）');
      return 1;
    }
    writeOpencodeConfig(loggedIn);
    if (!opencodeInstalled()) {
      warn('没找到 opencode 命令。配置已经写好，装完 opencode 就能用');
    }
    console.log('');
    ok('完成。在 opencode 里这样用：');
    console.log(`    opencode                然后 /models 选 ${loggedIn.map((k) => PROXY[k].provider).join(' 或 ')}`);
    console.log(`    opencode run -m ${PROXY[loggedIn[0]].provider}/Qwen3.8-Flash "你的问题"`);
    return 0;
  }

  if (action === 'uninstall') {
    const cfg = readJson(OPENCODE_JSON);
    if (!cfg || !cfg.provider) {
      warn('opencode 配置里没有 provider，无需清理');
      return 0;
    }
    let changed = false;
    for (const key of ['cn', 'global']) {
      const provider = PROXY[key].provider;
      if (cfg.provider[provider]) {
        delete cfg.provider[provider];
        changed = true;
        ok(`已从 opencode 配置里移除 ${provider}`);
      }
    }
    if (changed) {
      fs.writeFileSync(OPENCODE_JSON, `${JSON.stringify(cfg, null, 2)}\n`);
    }
    for (const key of ['cn', 'global']) stopProxy(key, { quiet: true });
    ok('已停止两个代理');
    return 0;
  }

  usage();
  return 1;
}

// ---------------------------------------------------------------- 积分与签到

/**
 * quota.js 是纯数据层（也供 pi 扩展 require），这里只负责把结果打印出来。
 * 用 require 而不是另写一份：否则 qoder2pi 与 /credits 会给出不同的数字。
 */
function loadQuota() {
  const candidates = [
    path.join(__dirname, 'quota.js'),
    path.join(HOME, '.qoder2pi', 'vendor', 'quota.js'),
    path.join(EXT_DIR, 'quota.js'),
  ];
  for (const file of candidates) {
    if (fs.existsSync(file)) {
      try {
        return require(file);
      } catch {
        // 损坏的副本就试下一个
      }
    }
  }
  fail('找不到 quota.js（重新运行安装脚本即可部署）');
}

async function cmdCredits(argv) {
  const q = loadQuota();
  // 参数顺序宽松：`credits cn`、`credits checkin cn`、`credits cn checkin` 都认
  let action = 'status';
  let regionKey = null;
  for (const raw of argv) {
    const arg = String(raw || '').toLowerCase();
    if (!arg) continue;
    if (REGION_ALIASES[arg]) regionKey = REGION_ALIASES[arg];
    else if (['status', 'show', 'checkin', '签到', 'json'].includes(arg)) action = arg;
    else if (['trae', 'workbuddy', 'workbuddy-global'].includes(arg)) regionKey = null, action = arg;
    else {
      usage();
      fail(`未知参数：${raw}`);
    }
  }
  let only = null;
  if (regionKey && REGIONS[regionKey]) only = [REGIONS[regionKey].provider];
  else if (['trae', 'workbuddy', 'workbuddy-global'].includes(action)) {
    only = [action];
    action = 'status';
  }

  if (action === 'status' || action === 'show') {
    const rows = await q.collectAll({ only });
    console.log(q.renderText(rows));
    return 0;
  }

  if (action === 'checkin' || action === '签到') {
    const rows = await q.collectAll({ only });
    console.log(q.renderText(rows));
    console.log('\n签到结果');
    let bad = 0;
    for (const row of rows) {
      if (!row.available) continue;
      if (row.kind === 'trae') {
        const pending = (row.accounts || []).filter((a) => !a.error && a.checkin.supported && !a.checkin.claimed);
        if (pending.length === 0) console.log(`  [${row.title}] 今日已签到（或签到已禁用）`);
        else {
          const r = await q.traeClaim();
          console.log(`  [${row.title}] ${pending.map((a) => a.name).join('、')} 今日未签到；${r.reason}`);
        }
        continue;
      }
      if (row.kind !== 'qoder') continue;
      if (row.checkin && !row.checkin.supported) {
        console.log(`  [${row.title}] 该区域当前没有每日签到活动`);
        continue;
      }
      const r = await q.qoderClaim(row.provider);
      console.log(`  [${row.title}] ${r.reason}`);
      if (!r.ok) bad += 1;
    }
    return bad ? 1 : 0;
  }

  if (action === 'json') {
    const rows = await q.collectAll({ only });
    process.stdout.write(`${JSON.stringify(rows, null, 2)}\n`);
    return 0;
  }

  usage();
  return 1;
}

function cmdModels() {
  if (!hasPi()) fail('未找到 pi');
  const out = [];
  for (const region of Object.values(REGIONS)) {
    const models = listModels(region) || [];
    out.push(`${region.title}（provider ${region.provider}）：${models.length} 个模型`);
    for (const line of models) out.push(`  ${line}`);
    out.push('');
  }
  return out.join('\n').trimEnd();
}

function cmdDoctor() {
  let bad = 0;
  const mark = (good, text, hint) => {
    if (good) ok(text);
    else {
      bad += 1;
      warn(`${text}${hint ? `　→ ${hint}` : ''}`);
    }
  };

  mark(true, `Node.js ${process.version}`);
  const piOk = hasPi();
  mark(piOk, `pi：${piOk ? run('pi', ['--version']).stdout || '可用' : '未找到'}`, '运行仓库的安装脚本');
  mark(extensionInstalled(), '扩展 pi-provider-qoder 已安装', '在本仓库运行 qoder2pi install-extension');
  const vendor = extensionPath();
  mark(!!vendor, `扩展副本：${vendor || '未知'}`, `重新运行安装脚本以写入 ${CONFIG}`);

  for (const region of Object.values(REGIONS)) {
    const st = loginState(region);
    mark(st.loggedIn, `${region.title}：${st.note}`, `qoder2pi login ${region.key} pt-xxxxxx`);
    const models = listModels(region);
    mark(Array.isArray(models) && models.length > 0, `${region.title} 在 pi 里可见模型：${models ? models.length : 0} 个`,
      '确认扩展已加载，并重开 pi');
  }

  console.log('');
  bad === 0 ? ok('自检全部通过') : warn(`自检有 ${bad} 项未通过`);
  if (bad > 0) process.exit(1);
}

