          : `${C.yellow}${G.idle}${C.reset} 未安装`],
      ],
      sections: [{
        id: 'regions',
        title: '区域',
        hint: `${G.running} 已登录　${G.idle} 未登录　·　两个区域并存，不需要切换`,
        rows,
      }],
      menu: [
        { id: 'login-cn', group: '登录', label: '登录国内版', note: 'qoder-cn · 粘贴 PAT' },
        { id: 'login-global', group: '登录', label: '登录国际版', note: 'qoder · 粘贴 PAT' },
        { id: 'logout', group: '登录', label: '退出登录', note: '删掉某个区域的凭证',
          pick: 'regions', pickTitle: '退出哪个区域的登录' },
        { id: 'credits', group: '积分', label: '余额与签到', note: 'Qoder / Trae / WorkBuddy 一表看全' },
        { id: 'checkin', group: '积分', label: '今日签到', note: '把能领的都领了' },
        { id: 'opencode', group: 'opencode', label: '接入 opencode', note: '起代理并写入 opencode 配置' },
        { id: 'opencode-off', group: 'opencode', label: '取消 opencode 接入', note: '从配置里移除并停掉代理' },
        { id: 'extension', group: '维护', label: '更新扩展', note: '从本仓库的副本重装' },
        { id: 'models', group: '维护', label: '查看模型', note: '两个区域各自在 pi 里可见的模型' },
        { id: 'doctor', group: '维护', label: '自检', note: '检查 pi、扩展与两个区域的登录态' },
        { id: 'quit', group: '界面', label: '退出', note: '' },
      ],
    };
  },

  async onAction(id, pickedKey) {
    if (id === 'quit') return { quit: true };

    if (id === 'login-cn' || id === 'login-global') {
      const regionKey = id === 'login-cn' ? 'cn' : 'global';
      const region = REGIONS[regionKey];
      // 输入 PAT 必须把终端交出去，界面里没法输入
      return {
        suspend: async () => {
          const pat = await promptLine(`粘贴 ${region.title} 的 PAT（直接回车取消）：`);
          if (!pat) return;
          const r = runSelf(['login', regionKey], { env: { QODER_PAT: pat } });
          if (!r.ok) throw new Error(r.out.split('\n').filter(Boolean).slice(-1)[0] || '登录失败');
        },
        after: '登录完成',
      };
    }

    if (id === 'credits' || id === 'checkin') {
      // 查余额要发网络请求，交给自己当子进程跑，界面不会冻住
      return {
        suspend: async () => {
          const r = runSelf(['credits', ...(id === 'checkin' ? ['checkin'] : [])], { inherit: true });
          if (!r.ok) throw new Error('查询失败');
        },
        after: id === 'checkin' ? '签到完成' : '已刷新',
      };
    }

    if (id === 'opencode' || id === 'opencode-off') {
      // 起代理要跑子进程、写配置要读模型目录，都交给自己当子进程跑：
      // 内部函数失败会 process.exit，直接调会把界面打乱。
      const args = id === 'opencode' ? ['opencode', 'install'] : ['opencode', 'uninstall'];
      return {
        suspend: async () => {
          const r = runSelf(args, { inherit: true });
          if (!r.ok) throw new Error(id === 'opencode' ? 'opencode 接入失败' : '取消接入失败');
        },
        after: id === 'opencode' ? 'opencode 已接入' : '已取消 opencode 接入',
      };
    }

    if (id === 'extension') {
      return {
        suspend: async () => {
          const r = runSelf(['install-extension'], { inherit: true });
          if (!r.ok) throw new Error('扩展安装失败');
        },
        after: '扩展已就绪',
      };
    }

    let r;
    if (id === 'logout') r = runSelf(['logout', pickedKey]);
    else if (id === 'models') r = { ok: true, out: cmdModels() };
    else if (id === 'doctor') r = runSelf(['doctor']);
    else return { flash: `未知操作：${id}`, error: true };

    if (id === 'models' || id === 'doctor' || !r.ok) {
      return { title: `${id === 'models' ? '模型' : '自检'} · Qoder`, body: r.out, error: !r.ok };
    }
    return { flash: r.out.split('\n').filter(Boolean).slice(-1)[0] || '完成' };
  },
};

/**
 * 不带子命令且是终端时，打开共享的总控界面并把焦点落在 Qoder 页。
 *
 * 为什么不在本地 createTui：总控把三个 provider 拼在一起，单独打开自己的
 * 那一页就等于保留了两套界面形态（页签在此，无页签在彼），和「TUI 集一体」
 * 相背。子命令（status / login / doctor 等）保持原样，不受影响。
 */
async function tuiMain() {
  return openConsole(1);
}

/**
 * 打开总控并落在指定页。
 *
 * 用 spawn 而不是 require：总控自己 require 了本文件，直接 require 回去会成环。
 * spawn 时把 stdio 交出去，让总控拥有真终端。
 */
function openConsole(pageNo) {
  const { spawnSync } = require('child_process');
  const console_ = require('path').join(__dirname, 'qodbuddy2pi');
  if (!fs.existsSync(console_)) {
    fail('找不到总控界面 qodbuddy2pi（与 qoder2pi 应在同一目录）。请在仓库里运行 ./install.sh 重新部署。');
  }
  const r = spawnSync(process.execPath, [console_, 'tui'], {
    stdio: 'inherit',
    env: { ...process.env, QODBUDDY_PAGE: String(pageNo) },
  });
  process.exit(r.status === null ? 1 : r.status);
}

